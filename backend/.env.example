SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (leave blank to use local SQLite)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=realestate
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# AI chatbot — Google Gemini's free tier (no credit card required).
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Email — leave EMAIL_HOST blank to just print emails to the console (default, no setup needed locally).
# For local testing with Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=you@gmail.com,
# EMAIL_HOST_PASSWORD=<a Gmail App Password, not your real password>.
# For production on AWS: point these at AWS SES's SMTP interface instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@estateos.local
